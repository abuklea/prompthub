generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id           String   @id // Supabase auth.users.id (no default, provided by Supabase)
  display_name String?
  created_at   DateTime @default(now())
  folders      Folder[]
  prompts      Prompt[]
}

model Folder {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  user_id    String
  parent_id  String?
  // Reason: never use disconnect on parent or folder. Both relations include user_id, which is also the owner
  // column, so a disconnect would null it. No code under src uses a Prisma disconnect today (searched 29/10/2026).
  // A changed user_id is refused while anything references the folder, instead of moving its subtree
  // (review finding S-4).
  parent     Folder?  @relation("NestedFolders", fields: [parent_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: Restrict)
  children   Folder[] @relation("NestedFolders")
  user       Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  prompts    Prompt[]

  @@unique([id, user_id])
  @@index([user_id, parent_id])
}

model Prompt {
  id          String                   @id @default(uuid())
  title       String?
  content     String
  // Full-text search vector: a Postgres STORED generated column derived from
  // title + content (migration 20260708000000). Never written by Prisma.
  content_tsv Unsupported("tsvector")?
  created_at  DateTime                 @default(now())
  updated_at  DateTime                 @updatedAt
  user_id     String
  folder_id   String?
  // Reason: same as Folder.parent: no disconnect, because it would null user_id. A changed folder user_id is refused
  // while a prompt is filed in it, instead of moving the prompt to the new owner (review finding S-4).
  folder      Folder?                  @relation(fields: [folder_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: Restrict)
  user        Profile                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  versions    PromptVersion[]
  tags        Tag[]

  @@index([user_id, folder_id])
  @@index([content_tsv], type: Gin)
}

model PromptVersion {
  id         Int      @id @default(autoincrement())
  diff       String   @default("") // No longer computed; snapshots are the authoritative version-storage model
  title_snapshot String?
  content_snapshot String @default("")
  created_at DateTime @default(now())
  prompt_id  String
  prompt     Prompt   @relation(fields: [prompt_id], references: [id], onDelete: Cascade)

  @@index([prompt_id])
}

model Tag {
  id      String   @id @default(uuid())
  name    String
  user_id String   // To scope tags per user
  prompts Prompt[]

  @@unique([name, user_id])
  @@index([user_id])
}
